{
	"compilerOptions" : {
		"allowJs" : true ,
		"allowSyntheticDefaultImports" : true ,
		"allowUnusedLabels" : true ,
		"baseUrl" : "." ,
		"declaration" : false ,
		"declarationMap" : false ,
		"esModuleInterop" : true ,
		"experimentalDecorators" : true ,
		"jsx" : "react-jsx" ,
		"resolveJsonModule" : true ,
		"strictFunctionTypes" : false ,
		"strict" : false ,
		"strictBindCallApply" : false ,
		"module" : "ESNext" ,
		"target" : "ESNext" ,
		"moduleResolution" : "bundler" ,
		"strictNullChecks" : false ,
		"allowUnreachableCode" : true ,
		"noEmit" : true ,
		"noImplicitAny" : false ,
		"noImplicitReturns" : false ,
		"noImplicitUseStrict" : false ,
		"noUnusedLocals" : false ,
		"noUnusedParameters" : false ,
		"preserveConstEnums" : true ,
		"checkJs" : true ,
		"allowSyntheticDefaultImports" : true ,
		"skipLibCheck" : true ,
		"allowUmdGlobalAccess" : true ,
		// Cursor 捆绑 TS 6 起 types 默认 []，不会自动加载 @types/node。
		// 仅配 typeRoots 不够，node:test / node:fs 等内置模块要靠这份显式列表。
		"types" : [ "node" ] ,
		"typeRoots" : [
			"../../node_modules/@types"
		] ,
		"paths" : {
			"#root/*" : [
				"../../*"
			] ,
			"#main/*" : [
				"./src/Main/*"
			] ,
			"#src/*" : [
				"./src/*"
			] ,
			"#shared/*" : [
				"./src/shared/*"
			] ,
			"#Views/shared/*" : [
				"./src/Views/shared/*"
			] ,
			"#root-projects/*" : [
				"../../projects/*"
			] ,
			"#generics/*" : [
				"../../generic-services/*"
			] ,
			"#project/*" : [
				"./*"
			]
		}
	},
	"include" : [
		"src" ,
		"tests" ,
		"scripts" ,
		"global.d.ts" ,
		"../../generic-services/*",
		"../../global.d.ts" ,
		"../../g.d.ts" ,
	],
	"exclude" : ["./src/Views"]
}
