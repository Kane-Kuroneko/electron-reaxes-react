{
	"name": "chataio",
	"version": "1.0.5",
	"main": "dist/main.js",
	"keywords": [],
	"author": "",
	"license": "WTFPL",
	"scripts": {
		"start:webpack": "yarn --cwd ../.. tsx scripts/webpack.start/index.ts ChatAIO 4444",
		"start:electron": "yarn --cwd ../.. tsx scripts/electron.start/index.ts ChatAIO",
		"build": "yarn build:webpack && yarn build:electron",
		"build:webpack": "yarn --cwd ../.. tsx scripts/webpack.build/index.ts ChatAIO production",
		"build:electron": "yarn --cwd ../.. tsx scripts/electron.build/index.ts ChatAIO",
		"build:electron:mac": "yarn --cwd ../.. tsx scripts/electron.build/index.ts ChatAIO -- --mac",
		"build:electron:win": "yarn --cwd ../.. tsx scripts/electron.build/index.ts ChatAIO -- --win",
		"build:electron:linux": "yarn --cwd ../.. tsx scripts/electron.build/index.ts ChatAIO -- --linux",
		"build:mac": "yarn build:webpack && yarn build:electron:mac",
		"build:win": "yarn build:webpack && yarn build:electron:win",
		"build:linux": "yarn build:webpack && yarn build:electron:linux",
		"analyze:perf": "yarn --cwd ../.. tsx --tsconfig projects/ChatAIO/tsconfig.json projects/ChatAIO/scripts/analyze-perf-logs.ts",
		"analyze:perf:ci": "yarn --cwd ../.. tsx --tsconfig projects/ChatAIO/tsconfig.json projects/ChatAIO/scripts/analyze-perf-logs.ts --ci",
		"analyze:menubar-boot": "yarn --cwd ../.. tsx --tsconfig projects/ChatAIO/tsconfig.json projects/ChatAIO/scripts/analyze-menubar-cold-start.ts",
		"test:menubar-boot": "yarn --cwd ../.. tsx --tsconfig projects/ChatAIO/tsconfig.json --test projects/ChatAIO/tests/menubar-cold-start-verdict.test.ts",
		"test:ai-order": "yarn --cwd ../.. tsx --tsconfig projects/ChatAIO/tsconfig.json --test projects/ChatAIO/tests/ai-list-reorder.test.ts projects/ChatAIO/tests/manage-ais-table-ux.test.ts",
		"test:ai-catalog": "yarn --cwd ../.. tsx --tsconfig projects/ChatAIO/tsconfig.json --test projects/ChatAIO/tests/ai-catalog-defaults.test.ts projects/ChatAIO/tests/ai-catalog-merge.test.ts projects/ChatAIO/tests/ai-catalog-sign.test.ts projects/ChatAIO/tests/ai-catalog-update.test.ts",
		"test:e2e": "yarn --cwd ../.. playwright test --config projects/ChatAIO/e2e/playwright.config.ts",
		"test:e2e:headed": "yarn --cwd ../.. playwright test --config projects/ChatAIO/e2e/playwright.config.ts --headed",
		"sign:ai-catalog": "yarn --cwd ../.. tsx --tsconfig projects/ChatAIO/tsconfig.json projects/ChatAIO/scripts/sign-ai-catalog.ts",
		"publish:ai-catalog": "yarn --cwd ../.. tsx --tsconfig projects/ChatAIO/tsconfig.json projects/ChatAIO/scripts/publish-ai-catalog.ts",
		"generate-icons": "yarn --cwd ../.. bash projects/ChatAIO/scripts/generate-icons.sh"
	},
	"type": "commonjs",
	"imports": {
		"#shared/*": "./src/shared/*"
	},
	"description": "Unified desktop client for multiple AI services",
	"dependencies": {
		"electron-store": "^11.0.2"
	},
	"devDependencies": {}
}
